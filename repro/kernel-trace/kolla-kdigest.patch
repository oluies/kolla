+object KDigest:
+  private val out = sys.env.get("KOLLA_KDIGEST").map(p => new java.io.PrintWriter(new java.io.FileWriter(p)))
+  var active = false
+  var hash: Long = 0L
+  var calls = 0L
+  var unfolds = 0L
+  var depth = 0
+  private val names = sys.env.get("KOLLA_KD_NAMES").map(p => scala.io.Source.fromFile(p, "UTF-8").getLines().toSet)
+  private val dump  = sys.env.get("KOLLA_KD_DUMP").map(p => new java.io.PrintWriter(new java.io.FileWriter(p)))
+  private var dumping = false
+  def mix(s0: String): Unit =
+    val s = s0.replace("«", "").replace("»", "")
+    if dumping then dump.get.println(s)
+    s.getBytes("UTF-8").foreach { b => hash = (hash ^ (b & 0xffL)) * 1099511628211L }
+    hash = (hash ^ 10L) * 1099511628211L
+  def begin(n: Name): Unit = if out.isDefined then
+    val nm = n.toString.replace("«", "").replace("»", "")
+    dumping = names.exists(_.contains(nm)) && dump.isDefined
+    if dumping then dump.get.println(s"@ $nm")
+    active = true; hash = 0xcbf29ce484222325L; calls = 0L; unfolds = 0L; depth = 0
+  def end(n: Name): Unit = if active then
+    active = false
+    out.get.println(f"${n.toString.replace("«", "").replace("»", "")}\t$calls\t$unfolds\t$hash%016x"); out.get.flush()
+    dump.foreach(_.flush())
+  def head(e: Expr): String =
+    val h = Expr.getAppFn(e) match
+      case c: Expr.Const   => c.name.toString
+      case p: Expr.Proj    => s"proj:${p.typeName}.${p.idx}"
+      case _: Expr.BVar    => "bvar"
+      case _: Expr.FVar    => "fvar"
+      case _: Expr.Sort    => "sort"
+      case _: Expr.Lam     => "lam"
+      case _: Expr.ForallE => "pi"
+      case _: Expr.LetE    => "let"
+      case _: Expr.Lit     => "lit"
+      case _: Expr.MData   => "mdata"
+      case _               => "other"
+    s"$h/${Expr.getAppNumArgs(e)}"
+
 object TypeChecker:
   val defaultMaxSteps: Long = 1L << 32
   val maxTraceEntries: Int  = 32
