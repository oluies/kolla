+/** Per-thread, so that `--jobs` gives each declaration its own digest. */
+final class KDState:
+  var active = false
+  var hash: Long = 0L
+  var calls = 0L
+  var unfolds = 0L
+  var depth = 0
+  var dumping = false
+
+object KDigest:
+  private val out = sys.env.get("KOLLA_KDIGEST").map(p => new java.io.PrintWriter(new java.io.FileWriter(p)))
+  private val names = sys.env.get("KOLLA_KD_NAMES").map(p => scala.io.Source.fromFile(p, "UTF-8").getLines().toSet)
+  private val dump  = sys.env.get("KOLLA_KD_DUMP").map(p => new java.io.PrintWriter(new java.io.FileWriter(p)))
+  private val st = ThreadLocal.withInitial(() => new KDState)
+  def enabled: Boolean = out.isDefined
+  def active: Boolean = st.get.active
+  def calls: Long = st.get.calls
+  def calls_=(v: Long): Unit = st.get.calls = v
+  def unfolds: Long = st.get.unfolds
+  def unfolds_=(v: Long): Unit = st.get.unfolds = v
+  def depth: Int = st.get.depth
+  def depth_=(v: Int): Unit = st.get.depth = v
+  def mix(s0: String): Unit =
+    val k = st.get
+    val s = s0.replace("«", "").replace("»", "")
+    if k.dumping then dump.synchronized(dump.get.println(s))
+    var h = k.hash
+    s.getBytes("UTF-8").foreach { b => h = (h ^ (b & 0xffL)) * 1099511628211L }
+    k.hash = (h ^ 10L) * 1099511628211L
+  def note(s0: String): Unit =
+    val k = st.get
+    if k.active && k.dumping then dump.synchronized(dump.get.println("# " + s0))
+  def begin(n: Name): Unit = if out.isDefined then
+    val k  = st.get
+    val nm = n.toString.replace("«", "").replace("»", "")
+    k.dumping = names.exists(_.contains(nm)) && dump.isDefined
+    if k.dumping then dump.synchronized(dump.get.println(s"@ $nm"))
+    k.active = true; k.hash = 0xcbf29ce484222325L; k.calls = 0L; k.unfolds = 0L; k.depth = 0
+  def end(n: Name): Unit =
+    val k = st.get
+    if k.active then
+      k.active = false
+      out.synchronized {
+        out.get.println(f"${n.toString.replace("«", "").replace("»", "")}\t${k.calls}\t${k.unfolds}\t${k.hash}%016x"); out.get.flush()
+      }
+      dump.foreach(d => d.synchronized(d.flush()))
+  def head(e: Expr): String =
+    val h = Expr.getAppFn(e) match
+      case c: Expr.Const   => c.name.toString
+      case p: Expr.Proj    => s"proj:${p.typeName}.${p.idx}"
+      case _: Expr.BVar    => "bvar"
+      case _: Expr.FVar    => "fvar"
+      case _: Expr.Sort    => "sort"
+      case _: Expr.Lam     => "lam"
+      case _: Expr.ForallE => "pi"
+      case _: Expr.LetE    => "let"
+      case _: Expr.Lit     => "lit"
+      case _: Expr.MData   => "mdata"
+      case _               => "other"
+    s"$h/${Expr.getAppNumArgs(e)}"
+
+  /** One canonical spelling of a closed term, shared with the Lean patch:
+    * binder names and info and `mdata` left out, levels and names spelled out.
+    */
+  def serLevel(l: Level, o: StringBuilder): Unit = l match
+    case Level.Zero        => o ++= "0"
+    case Level.Succ(a)     => o ++= "(s "; serLevel(a, o); o ++= ")"
+    case Level.Max(a, b)   => o ++= "(max "; serLevel(a, o); o ++= " "; serLevel(b, o); o ++= ")"
+    case Level.IMax(a, b)  => o ++= "(imax "; serLevel(a, o); o ++= " "; serLevel(b, o); o ++= ")"
+    case Level.Param(n)    => o ++= n.toString
+    case Level.MVar(_)     => o ++= "?"
+  def ser(e: Expr, o: StringBuilder): Unit = e match
+    case b: Expr.BVar    => o ++= "#"; o ++= b.idx.toString
+    case _: Expr.FVar    => o ++= "fv"
+    case _: Expr.MVar    => o ++= "mv"
+    case s: Expr.Sort    => o ++= "(S "; serLevel(s.level, o); o ++= ")"
+    case c: Expr.Const   =>
+      o ++= c.name.toString; o ++= "{"
+      c.levels.foreach { l => serLevel(l, o); o ++= "," }
+      o ++= "}"
+    case a: Expr.App     => o ++= "("; ser(a.fn, o); o ++= " "; ser(a.arg, o); o ++= ")"
+    case l: Expr.Lam     => o ++= "(L "; ser(l.binderType, o); o ++= " "; ser(l.body, o); o ++= ")"
+    case p: Expr.ForallE => o ++= "(P "; ser(p.binderType, o); o ++= " "; ser(p.body, o); o ++= ")"
+    case l: Expr.LetE    => o ++= "(let "; ser(l.tpe, o); o ++= " "; ser(l.value, o); o ++= " "; ser(l.body, o); o ++= ")"
+    case l: Expr.Lit     =>
+      l.value match
+        case Literal.NatVal(v) => o ++= v.toString
+        case Literal.StrVal(v) => o ++= "\""; o ++= v; o ++= "\""
+    case m: Expr.MData   => ser(m.expr, o)
+    case p: Expr.Proj    => o ++= "(J "; o ++= p.typeName.toString; o ++= " "; o ++= p.idx.toString; o ++= " "; ser(p.struct, o); o ++= ")"
+  private def serStr(e: Expr): String = { val o = new StringBuilder; ser(e, o); o.result() }
+
+  /** What a block produced, mixed after its check. The Lean patch does the same
+    * from the environment `add_inductive` returns.
+    */
+  def inductive(env: Environment, types: List[InductiveVal]): Unit = if active then
+    types.foreach { iv =>
+      val cv = iv.toConstantVal
+      mix(s"T ${cv.name} ${iv.numParams} ${iv.numIndices} ${iv.numNested} ${if iv.isRec then "r" else "-"}${if iv.isReflexive then "x" else "-"} ${serStr(cv.tpe)}")
+      iv.ctors.foreach { c =>
+        val ci = env.get(c).asInstanceOf[ConstantInfo.CtorInfo].value
+        mix(s"C $c ${ci.cidx} ${ci.numParams} ${ci.numFields} ${serStr(ci.toConstantVal.tpe)}")
+      }
+    }
+    val recNames = types.map(_.toConstantVal.name.str("rec")) ++
+      (1 to types.head.numNested).map(i => types.head.toConstantVal.name.str(s"rec_$i"))
+    recNames.map(_.toString).sorted.foreach { rn =>
+      env.find(Name.parse(rn)) match
+        case Some(ConstantInfo.RecInfo(rv)) =>
+          mix(s"R $rn ${rv.numParams} ${rv.numIndices} ${rv.numMotives} ${rv.numMinors} ${if rv.k then "k" else "-"} ${serStr(rv.toConstantVal.tpe)}")
+          rv.rules.foreach(r => mix(s"RR ${r.ctor} ${r.nfields} ${serStr(r.rhs)}"))
+        case _ => mix(s"R $rn missing")
+    }
+
