+environment environment::add_inductive(declaration const & d) const {
+    inductive_decl ind_d(d);
+    name first = head(ind_d.get_types()).get_name();
+    kd_begin(first);
+    environment new_env = add_inductive_core(d);
+    if (kd_is_active()) {
+        for (inductive_type const & t : ind_d.get_types()) {
+            constant_info ci = new_env.get(t.get_name());
+            inductive_val iv = ci.to_inductive_val();
+            std::string o = "T " + t.get_name().to_string() + " " + std::to_string(iv.get_nparams()) + " " +
+                std::to_string(iv.get_nindices()) + " " + std::to_string(iv.get_nnested()) + " " +
+                (iv.is_rec() ? "r" : "-") + (iv.is_reflexive() ? "x" : "-") + " ";
+            kd_ser(ci.get_type(), o); kd_mix_ext(o);
+            for (name const & c : iv.get_cnstrs()) {
+                constant_info cc = new_env.get(c);
+                constructor_val cv = cc.to_constructor_val();
+                o = "C " + c.to_string() + " " + std::to_string(cv.get_cidx()) + " " +
+                    std::to_string(cv.get_nparams()) + " " + std::to_string(cv.get_nfields()) + " ";
+                kd_ser(cc.get_type(), o); kd_mix_ext(o);
+            }
+        }
+        std::vector<std::pair<std::string, name>> recs;
+        for (inductive_type const & t : ind_d.get_types()) {
+            name rn = mk_rec_name(t.get_name()); recs.emplace_back(rn.to_string(), rn);
+        }
+        unsigned nn = new_env.get(first).to_inductive_val().get_nnested();
+        for (unsigned i = 1; i <= nn; i++) {
+            name rn(first, ("rec_" + std::to_string(i)).c_str()); recs.emplace_back(rn.to_string(), rn);
+        }
+        std::sort(recs.begin(), recs.end(), [](auto const & a, auto const & b) { return a.first < b.first; });
+        for (auto const & pr : recs) {
+            optional<constant_info> ci = new_env.find(pr.second);
+            if (!ci || !ci->is_recursor()) { kd_mix_ext("R " + pr.first + " missing"); continue; }
+            recursor_val rv = ci->to_recursor_val();
+            std::string o = "R " + pr.first + " " + std::to_string(rv.get_nparams()) + " " + std::to_string(rv.get_nindices()) + " " +
+                std::to_string(rv.get_nmotives()) + " " + std::to_string(rv.get_nminors()) + " " + (rv.is_k() ? "k" : "-") + " ";
+            kd_ser(ci->get_type(), o); kd_mix_ext(o);
+            for (recursor_rule const & r : rv.get_rules()) {
+                o = "RR " + r.get_cnstr().to_string() + " " + std::to_string(r.get_nfields()) + " ";
+                kd_ser(r.get_rhs(), o); kd_mix_ext(o);
+            }
+        }
+    }
+    kd_end(first);
+    return new_env;
+}
