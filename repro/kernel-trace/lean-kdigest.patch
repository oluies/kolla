+/* KTRACE: a structural trace of is_def_eq_core and unfold_definition_core,
+   enabled by LEAN_KTRACE=<max entries>, for diffing against another kernel. */
+static long g_kt_limit = -1;
+static long g_kt_count = 0;
+static int  g_kt_depth = 0;
+static long kt_limit() {
+    if (g_kt_limit < 0) {
+        char const * v = getenv("LEAN_KTRACE");
+        g_kt_limit = v ? atol(v) : 0;
+    }
+    return g_kt_limit;
+}
+static bool kt_on() { return kt_limit() > 0 && g_kt_count < kt_limit(); }
+/* KDIGEST: one line per declaration, LEAN_KDIGEST=<file>: name, is_def_eq_core
+   calls, unfolds, FNV-1a of the event sequence, for joining against kolla's. */
+static FILE *        g_kd_file = nullptr;
+static bool          g_kd_init = false;
+static bool          g_kd_active = false;
+static unsigned long long g_kd_hash = 0;
+static long          g_kd_calls = 0, g_kd_unfolds = 0;
+static FILE * g_kd_dump = nullptr;
+static std::set<std::string> * g_kd_names = nullptr;
+static bool g_kd_dumping = false;
+static void kd_mix(std::string const & s) {
+    if (g_kd_dumping) fprintf(g_kd_dump, "%s\n", s.c_str());
+    for (unsigned char c : s) { g_kd_hash ^= c; g_kd_hash *= 1099511628211ULL; }
+    g_kd_hash ^= 10; g_kd_hash *= 1099511628211ULL;
+}
+void kd_begin(name const & n) {
+    if (!g_kd_init) {
+        g_kd_init = true;
+        char const * v = getenv("LEAN_KDIGEST");
+        if (v) g_kd_file = fopen(v, "w");
+        char const * ns = getenv("LEAN_KD_NAMES");
+        char const * dp = getenv("LEAN_KD_DUMP");
+        if (ns && dp) {
+            g_kd_dump = fopen(dp, "w");
+            g_kd_names = new std::set<std::string>();
+            std::ifstream in(ns); std::string line;
+            while (std::getline(in, line)) g_kd_names->insert(line);
+        }
+    }
+    if (!g_kd_file) return;
+    g_kd_dumping = g_kd_names && g_kd_names->count(n.to_string()) > 0;
+    if (g_kd_dumping) fprintf(g_kd_dump, "@ %s\n", n.to_string().c_str());
+    g_kd_active = true; g_kd_hash = 14695981039346656037ULL;
+    g_kd_calls = 0; g_kd_unfolds = 0; g_kt_depth = 0;
+}
+void kd_end(name const & n) {
+    if (!g_kd_active) return;
+    g_kd_active = false;
+    fprintf(g_kd_file, "%s\t%ld\t%ld\t%016llx\n", n.to_string().c_str(), g_kd_calls, g_kd_unfolds, g_kd_hash);
+    fflush(g_kd_file);
+}
+static std::string kt_head(expr const & e) {
+    expr const & f = get_app_fn(e);
+    std::string h;
+    switch (f.kind()) {
+    case expr_kind::Const:  h = const_name(f).to_string(); break;
+    case expr_kind::Proj: {
+        unsigned i = 0; to_proj_idx(proj_idx(f), i);
+        h = "proj:" + proj_sname(f).to_string() + "." + std::to_string(i); break;
+    }
+    case expr_kind::BVar:   h = "bvar"; break;
+    case expr_kind::FVar:   h = "fvar"; break;
+    case expr_kind::MVar:   h = "mvar"; break;
+    case expr_kind::Sort:   h = "sort"; break;
+    case expr_kind::Lambda: h = "lam"; break;
+    case expr_kind::Pi:     h = "pi"; break;
+    case expr_kind::Let:    h = "let"; break;
+    case expr_kind::Lit:    h = "lit"; break;
+    case expr_kind::MData:  h = "mdata"; break;
+    case expr_kind::App:    h = "app"; break;
+    }
+    return h + "/" + std::to_string(get_app_num_args(e));
+}
