+/* KDIGEST: one canonical spelling of a closed term, shared with kolla's patch:
+   binder names and info and mdata left out, levels and names spelled out. */
+static void kd_ser_level(level const & l, std::string & o) {
+    switch (kind(l)) {
+    case level_kind::Zero:  o += "0"; break;
+    case level_kind::Succ:  o += "(s "; kd_ser_level(succ_of(l), o); o += ")"; break;
+    case level_kind::Max:   o += "(max "; kd_ser_level(level_lhs(l), o); o += " "; kd_ser_level(level_rhs(l), o); o += ")"; break;
+    case level_kind::IMax:  o += "(imax "; kd_ser_level(level_lhs(l), o); o += " "; kd_ser_level(level_rhs(l), o); o += ")"; break;
+    case level_kind::Param: o += param_id(l).to_string(); break;
+    case level_kind::MVar:  o += "?"; break;
+    }
+}
+static void kd_ser(expr const & e, std::string & o) {
+    switch (e.kind()) {
+    case expr_kind::BVar:   o += "#"; o += bvar_idx(e).to_std_string(); break;
+    case expr_kind::FVar:   o += "fv"; break;
+    case expr_kind::MVar:   o += "mv"; break;
+    case expr_kind::Sort:   o += "(S "; kd_ser_level(sort_level(e), o); o += ")"; break;
+    case expr_kind::Const:
+        o += const_name(e).to_string(); o += "{";
+        for (level const & l : const_levels(e)) { kd_ser_level(l, o); o += ","; }
+        o += "}"; break;
+    case expr_kind::App:    o += "("; kd_ser(app_fn(e), o); o += " "; kd_ser(app_arg(e), o); o += ")"; break;
+    case expr_kind::Lambda: o += "(L "; kd_ser(binding_domain(e), o); o += " "; kd_ser(binding_body(e), o); o += ")"; break;
+    case expr_kind::Pi:     o += "(P "; kd_ser(binding_domain(e), o); o += " "; kd_ser(binding_body(e), o); o += ")"; break;
+    case expr_kind::Let:    o += "(let "; kd_ser(let_type(e), o); o += " "; kd_ser(let_value(e), o); o += " "; kd_ser(let_body(e), o); o += ")"; break;
+    case expr_kind::Lit:
+        if (lit_value(e).kind() == literal_kind::Nat) o += lit_value(e).get_nat().to_std_string();
+        else { o += "\""; o += lit_value(e).get_string().to_std_string(); o += "\""; }
+        break;
+    case expr_kind::MData:  kd_ser(mdata_expr(e), o); break;
+    case expr_kind::Proj:   o += "(J "; o += proj_sname(e).to_string(); o += " "; o += proj_idx(e).to_std_string(); o += " "; kd_ser(proj_expr(e), o); o += ")"; break;
+    }
+}
