+    }
+    g_kt_depth++;
+    bool r = is_def_eq_core_impl(t, s);
+    g_kt_depth--;
+    if (g_kd_active) kd_mix(std::to_string(g_kt_depth) + " < " + (r ? "1" : "0"));
+    if (n > 0) fprintf(stderr, "KT %ld %d < %d\n", n, g_kt_depth, r ? 1 : 0);
+    return r;
+}
