//| mill-version: 1.3.0
package build

import mill.*
import mill.scalalib.*
import mill.scalajslib.*
import mill.scalajslib.api.ModuleKind
import mill.scalanativelib.*
import mill.scalalib.publish.*

object v {
  val scala           = "3.9.0"
  val scalaJs         = "1.22.0"
  val scalaNative     = "0.5.12"
  val cats            = "2.13.0"
  val catsEffect      = "3.7.1"
  val fs2             = "3.14.0"
  val munit           = "1.3.6"
  val munitScalacheck = "1.3.1"
  val munitCatsEffect = "2.2.1"
  val scalacheck      = "1.20.0"
}

/** Settings shared by every module. A single-platform module uses this one
  * directly; mixing in `PlatformScalaModule` would redirect its sources to the
  * parent directory, which for a top-level module is the repository root.
  */
trait KollaBase extends ScalaModule {
  def scalaVersion = v.scala
  def scalacOptions = Seq("-deprecation", "-feature", "-unchecked")

  trait KollaTests extends ScalaTests with TestModule.Munit {
    def mvnDeps = Seq(
      mvn"org.scalameta::munit::${v.munit}",
      mvn"org.scalameta::munit-scalacheck::${v.munitScalacheck}",
      mvn"org.scalacheck::scalacheck::${v.scalacheck}"
    )
  }
}

/** Publishing, for the JVM artifacts only.
  *
  * Scala 3 reads the TASTy of earlier 3.x releases, so a consumer on a later
  * minor can depend on an artifact built with `v.scala`; the reverse does not
  * hold. That is why there is no cross-build over Scala versions here. See
  * docs/build.md.
  */
trait KollaPublish extends SonatypeCentralPublishModule {
  def publishVersion = "0.1.0"
  def pomSettings = PomSettings(
    description = "A Lean 4 kernel type checker",
    organization = "io.github.oluies",
    url = "https://github.com/oluies/kolla",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("oluies", "kolla"),
    developers = Seq(Developer("oluies", "oluies", "https://github.com/oluies"))
  )
}

/** A module cross-built over JVM, Scala.js and Scala Native. */
trait KollaModule extends KollaBase with PlatformScalaModule

trait KollaJsModule extends KollaModule with ScalaJSModule {
  def scalaJSVersion = v.scalaJs
}

trait KollaNativeModule extends KollaModule with ScalaNativeModule {
  def scalaNativeVersion = v.scalaNative
}

object kernel extends Module {
  trait Shared extends KollaModule {
    def mvnDeps = Seq(mvn"org.typelevel::cats-core::${v.cats}")
  }
  object jvm extends Shared with KollaPublish {
    def artifactName = "kolla-kernel"
    object test extends KollaTests
  }
  object js extends Shared with KollaJsModule {
    object test extends KollaTests with ScalaJSTests
  }
  object native extends Shared with KollaNativeModule {
    object test extends KollaTests with ScalaNativeTests
  }
}

object difftest extends KollaBase {
  def moduleDeps = Seq(kernel.jvm, build.`export`.jvm, dsl.jvm)
  def mainClass = Some("kolla.difftest.Main")
  /** A library corpus needs more heap than the default quarter of RAM on a
    * small machine: `init` is 6.5 million export lines and peaks at 3 GB, and
    * `lean` is larger again. A cap only matters if the workload reaches it, so
    * this is safe on a runner with less memory than the number names.
    */
  def forkArgs = Seq(sys.env.getOrElse("KOLLA_XMX", "-Xmx16g"))
  def mvnDeps = Seq(
    mvn"org.typelevel::cats-core::${v.cats}",
    mvn"org.typelevel::cats-effect::${v.catsEffect}",
    mvn"co.fs2::fs2-core::${v.fs2}",
    mvn"co.fs2::fs2-io::${v.fs2}"
  )
  object test extends KollaTests {
    def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"org.typelevel::munit-cats-effect::${v.munitCatsEffect}"
    )
  }
}

/** The command line, on the JVM and as a native binary. */
object cli extends Module {
  trait Shared extends KollaModule {
    def mvnDeps = Seq(
      mvn"org.typelevel::cats-core::${v.cats}",
      mvn"org.typelevel::cats-effect::${v.catsEffect}",
      mvn"co.fs2::fs2-core::${v.fs2}",
      mvn"co.fs2::fs2-io::${v.fs2}"
    )
  }
  object jvm extends Shared {
    def moduleDeps = Seq(kernel.jvm, build.`export`.jvm, dsl.jvm)
    def mainClass = Some("kolla.cli.Main")
    object test extends KollaTests {
      def mvnDeps = super.mvnDeps() ++ Seq(mvn"org.typelevel::munit-cats-effect::${v.munitCatsEffect}")
    }
  }
  object native extends Shared with KollaNativeModule {
    def moduleDeps = Seq(kernel.native, build.`export`.native, dsl.native)
    def mainClass = Some("kolla.cli.Main")
    object test extends KollaTests with ScalaNativeTests {
      def mvnDeps = super.mvnDeps() ++ Seq(mvn"org.typelevel::munit-cats-effect::${v.munitCatsEffect}")
    }
  }
}

/** The browser front end. */
object web extends Module {
  object js extends KollaModule with KollaJsModule {
    def moduleDeps = Seq(kernel.js, build.`export`.js, dsl.js)
    def mvnDeps = Seq(
      mvn"org.typelevel::cats-core::${v.cats}",
      mvn"org.typelevel::cats-effect::${v.catsEffect}"
    )
    def mainClass = Some("kolla.web.Main")
    def moduleKind = ModuleKind.NoModule

    /** The page that loads the bundle. Declared as a source so a change to it
      * invalidates `bundle`.
      */
    def indexHtml = Task.Source(moduleDir / "index.html")

    /** The Node entry point, which runs the same bundle without a document. */
    def runJs = Task.Source(moduleDir / "run.js")

    /** The browser smoke test, which drives the published page in Chromium. */
    def smokeJs = Task.Source(moduleDir / "smoke.js")

    /** A servable directory: the linked bundle next to the page that loads it. */
    def bundle = Task {
      val out = Task.dest
      os.copy(fastLinkJS().dest.path, out, mergeFolders = true, replaceExisting = true)
      os.copy.over(indexHtml().path, out / "index.html")
      os.copy.over(runJs().path, out / "run.js")
      os.copy.over(smokeJs().path, out / "smoke.js")
      PathRef(out)
    }

    /** The same, fully optimised, for publishing. */
    def bundleOpt = Task {
      val out = Task.dest
      os.copy(fullLinkJS().dest.path, out, mergeFolders = true, replaceExisting = true)
      os.copy.over(indexHtml().path, out / "index.html")
      os.copy.over(runJs().path, out / "run.js")
      PathRef(out)
    }
    object test extends KollaTests with ScalaJSTests {
      def mvnDeps = super.mvnDeps() ++ Seq(mvn"org.typelevel::munit-cats-effect::${v.munitCatsEffect}")
    }
  }
}

object dsl extends Module {
  trait Shared extends KollaModule {
    def mvnDeps = Seq(mvn"org.typelevel::cats-core::${v.cats}")
  }
  object jvm extends Shared with KollaPublish {
    def artifactName = "kolla-dsl"
    def moduleDeps = Seq(kernel.jvm)
    object test extends KollaTests {
      def moduleDeps = super.moduleDeps ++ Seq(build.`export`.jvm)
    }
  }
  object js extends Shared with KollaJsModule {
    def moduleDeps = Seq(kernel.js)
    object test extends KollaTests with ScalaJSTests
  }
  object native extends Shared with KollaNativeModule {
    def moduleDeps = Seq(kernel.native)
    object test extends KollaTests with ScalaNativeTests
  }
}

object `export` extends Module {
  trait Shared extends KollaModule {
    def mvnDeps = Seq(
      mvn"org.typelevel::cats-core::${v.cats}",
      mvn"co.fs2::fs2-core::${v.fs2}"
    )
  }
  object jvm extends Shared with KollaPublish {
    def artifactName = "kolla-export"
    def moduleDeps = Seq(kernel.jvm)
    object test extends KollaTests
  }
  object js extends Shared with KollaJsModule {
    def moduleDeps = Seq(kernel.js)
    object test extends KollaTests with ScalaJSTests
  }
  object native extends Shared with KollaNativeModule {
    def moduleDeps = Seq(kernel.native)
    object test extends KollaTests with ScalaNativeTests
  }
}
